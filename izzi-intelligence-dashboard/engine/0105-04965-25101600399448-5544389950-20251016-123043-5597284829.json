      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 178,
      "start": 606.02,
      "end": 610.26,
      "text": " ¿Qué más sigue, disculpen?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 179,
      "start": 610.26,
      "end": 620.1,
      "text": " A ver, A, E, C, T, M, E.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 180,
      "start": 620.1,
      "end": 622.19,
      "text": " L, E.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 181,
      "start": 622.19,
      "end": 623.19,
      "text": " X.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 182,
      "start": 623.19,
      "end": 624.38,
      "text": " X.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 183,
      "start": 624.38,
      "end": 625.38,
      "text": " Y.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 184,
      "start": 625.38,
      "end": 626.38,
      "text": " Y.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 185,
      "start": 626.38,
      "end": 627.8,
      "text": " O.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 186,
      "start": 627.8,
      "end": 628.8,
      "text": " Y.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 187,
      "start": 628.8,
      "end": 629.8,
      "text": " Claro.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 188,
      "start": 629.8,
      "end": 638.85,
      "text": " ¿Podría que le pueda marcar en otro momento?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 189,
      "start": 638.85,
      "end": 647.77,
      "text": " OK, en ese momento no gusta lo que es la chica de cobertura.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 190,
      "start": 647.77,
      "end": 651.99,
      "text": " ¿Cuál sería el motivo, disculpen, que no pueda chicarla con la cobertura en ese momento?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 191,
      "start": 651.99,
      "end": 656.99,
      "text": " El motivo sería porque no me hace el código postal.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 192,
      "start": 656.99,
      "end": 659.99,
      "text": " Aparte de que no me hace el código postal, no me lo sé de memoria.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 193,
      "start": 659.99,
      "end": 662.99,
      "text": " No lo tengo a la mano, sería que buscarlo.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 194,
      "start": 662.99,
      "end": 667.99,
      "text": " Pero como tengo ahora sí que unos pequeños asientos también.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 195,
      "start": 667.99,
      "end": 669.6,
      "text": " OK.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 196,
      "start": 669.6,
      "end": 672.6,
      "text": " ¿No sería interesante la contratación?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 197,
      "start": 672.6,
      "end": 673.66,
      "text": " Perdón.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 198,
      "start": 673.66,
      "end": 676.82,
      "text": " ¿No sería interesante la contratación del servicio?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 199,
      "start": 676.82,
      "end": 682.82,
      "text": " Sí me interesaría, pero sería posible que le pueda marcar más un ratito.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 200,
      "start": 682.82,
      "end": 684.95,
      "text": " ¿En qué hora viene, por favor?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 201,
      "start": 684.95,
      "end": 688.05,
      "text": " Para checarles, igual, bien.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 202,
      "start": 688.05,
      "end": 690.05,
      "text": " Claro, ¿en qué hora viene, por favor?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 203,
      "start": 690.05,
      "end": 694.27,
      "text": " Se viene entre las ocho y las nueve.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 204,
      "start": 694.27,
      "end": 697.78,
      "text": " OK, en esta hora me comunico, ¿de acuerdo?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 205,
      "start": 697.78,
      "end": 698.78,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 206,
      "start": 698.78,
      "end": 699.78,
      "text": " Claro, buenito día, cabrón.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 207,
      "start": 699.78,
      "end": 700.78,
      "text": " Igualmente.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 208,
      "start": 700.78,
      "end": 703.78,
      "text": " Sí, la atiende a la anguita de la compañía, y sí, buenito día.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    }
