  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 7.0,
      "text": " Hola, ¿te gustaría tener Internet, más televisión, más el mejor entretenimiento con VIX Premium,",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 1,
      "start": 7.0,
      "end": 11.0,
      "text": " más Sky Sports desde 350 pesos el primer mes?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 2,
      "start": 11.0,
      "end": 13.0,
      "text": " Con IZI es posible.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 3,
      "start": 13.0,
      "end": 16.0,
      "text": " ¿Te interesa? Un asesor te está esperando.",
