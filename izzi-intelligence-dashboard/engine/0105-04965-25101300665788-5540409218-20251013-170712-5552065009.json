      "role": null,
      "words": []
    },
    {
      "id": 6,
      "start": 24.22,
      "end": 33.5,
      "text": " Hola, ¿qué tal? Buenas tardes. Gracias por comunicarse al área de consultaciones de IZI.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 7,
      "start": 33.5,
      "end": 36.91,
      "text": " La tiende Vanni Daniela. ¿Con quién tengo el gusto?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 8,
      "start": 36.91,
      "end": 43.3,
      "text": " Señorita, ¿qué es IZI? ¿Es igual que VIX o es diferente compañía?",
