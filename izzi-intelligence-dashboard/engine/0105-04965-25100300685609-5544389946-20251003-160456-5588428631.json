    {
      "id": 87,
      "start": 341.34,
      "end": 343.98,
      "text": " ¿Cuál es su número de casa?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 88,
      "start": 343.98,
      "end": 347.98,
      "text": " Estoy en el edificio E, departamento 403.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 89,
      "start": 347.98,
      "end": 350.33,
      "text": " ¿Edificio cuál, perdón?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 90,
      "start": 350.33,
      "end": 351.33,
