      "role": null,
      "words": []
    },
    {
      "id": 92,
      "start": 371.15,
      "end": 373.15,
      "text": " E. E de Ernesto.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 93,
      "start": 373.15,
      "end": 374.15,
      "text": " ¿Elefante?",
