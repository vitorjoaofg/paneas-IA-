      "role": null,
      "words": []
    },
    {
      "id": 95,
      "start": 375.15,
      "end": 386.98,
      "text": " Un momento más por favor.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 96,
      "start": 386.98,
      "end": 405.2,
      "text": " Un momentito más por favor.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 97,
      "start": 405.2,
      "end": 408.38,
      "text": " Sí, bueno.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 98,
      "start": 408.38,
      "end": 417.42,
      "text": " ¿Está cerca de qué edificio, disculpe?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 99,
      "start": 417.42,
      "end": 424.42,
      "text": " Está el Kentucky enfrente y la gasolinería de Shell.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 100,
      "start": 425.42,
      "end": 427.42,
      "text": " Y está este...",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 101,
      "start": 427.42,
      "end": 436.4,
      "text": " Pues está cerca de la bodega Herrera.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 102,
      "start": 436.4,
      "end": 439.4,
      "text": " Sí, mire, fíjate que justamente en su calle usted...",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 103,
      "start": 439.4,
      "end": 440.4,
      "text": " Ajá.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 104,
      "start": 440.4,
      "end": 441.4,
      "text": " No hay.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 105,
      "start": 441.4,
      "end": 442.4,
      "text": " Sí, hay.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 106,
      "start": 442.4,
      "end": 444.4,
      "text": " Pero al ladito sí hay.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 107,
      "start": 444.4,
      "end": 445.4,
      "text": " Ajá.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 108,
      "start": 445.4,
      "end": 446.72,
      "text": " Sí, habían venido.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 109,
      "start": 446.72,
      "end": 447.72,
      "text": " Perdón.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 110,
      "start": 447.72,
      "end": 450.2,
      "text": " Ya habían venido a lo que le comentaba.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 111,
      "start": 450.2,
      "end": 454.2,
      "text": " Sí, en ese caso sería que se esperaran únicamente a...",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 112,
      "start": 454.2,
      "end": 455.2,
      "text": " ¿Qué será?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 113,
      "start": 455.2,
      "end": 456.2,
      "text": " Un mesecito más.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 114,
      "start": 456.2,
      "end": 461.32,
      "text": " Yo creo que en un medio mes o un mes ya abren lo que es la cobertura en su zona.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 115,
      "start": 461.32,
      "end": 465.32,
      "text": " Porque ya están los puntos únicamente para que metan el poste y ya, y ya quede lo que es la cobertura.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 116,
      "start": 465.32,
      "end": 466.32,
      "text": " Ajá.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 117,
      "start": 466.32,
      "end": 471.32,
      "text": " Sí, porque el poste está sobre la avenida y yo en la privada estoy muy hasta el fondo.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 118,
      "start": 471.32,
      "end": 474.32,
      "text": " Y entonces llega nada más a la mitad de la cerrada.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 119,
      "start": 474.32,
      "end": 476.45,
      "text": " No llega hasta el fondo.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 120,
      "start": 476.45,
      "end": 478.06,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 121,
      "start": 478.06,
      "end": 481.06,
      "text": " Aunque me pareciera igual me sería comunicando en otra ocasión, ¿de acuerdo?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 122,
      "start": 481.06,
      "end": 483.06,
      "text": " Ándale, hasta luego.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 123,
      "start": 483.06,
      "end": 485.06,
      "text": " Claro, la atienda a la ingresana de la compañía y sí, buenito día.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 124,
      "start": 485.06,
      "end": 487.06,
      "text": " Gracias, hasta luego.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    }
