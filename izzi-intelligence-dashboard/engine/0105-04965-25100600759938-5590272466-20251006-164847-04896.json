    },
    {
      "id": 82,
      "start": 235.2,
      "end": 237.62,
      "text": " Ah, OK.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 83,
      "start": 237.62,
      "end": 239.72,
      "text": " Sí, sí, pues aquí si no,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 84,
      "start": 239.72,
      "end": 241.12,
      "text": " si no se le puede hacer la instalación,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 85,
      "start": 241.12,
      "end": 243.02,
      "text": " pues igual registramos su número,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 86,
      "start": 243.02,
      "end": 244.62,
      "text": " y cuando se puede habilitar,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 87,
      "start": 244.62,
      "end": 247.05,
      "text": " pues nos comunicamos con usted.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 88,
      "start": 247.05,
      "end": 248.15,
      "text": " Bueno.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 89,
      "start": 248.15,
      "end": 249.54,
      "text": " OK.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 90,
      "start": 249.54,
      "end": 250.84,
      "text": " Sí, es que aún está,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 91,
      "start": 250.84,
      "end": 253.38,
      "text": " si Dios me permite todavía,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 92,
      "start": 253.38,
      "end": 256.66,
      "text": " porque ya soy más para allá que para acá.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 93,
      "start": 256.66,
      "end": 262.41,
      "text": " Ya soy, a mí ya la tierra me aclava.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 94,
      "start": 262.41,
      "end": 263.64,
      "text": " ¿Cómo?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 95,
      "start": 263.64,
      "end": 265.34,
      "text": " Pues sí, porque ya estoy,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 96,
      "start": 265.34,
      "end": 266.74,
      "text": " bueno, no muy grande.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 97,
      "start": 266.74,
      "end": 270.76,
      "text": " Tengo 77 años, pero estoy enferma.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 98,
      "start": 270.76,
      "end": 273.19,
      "text": " Cuatro infartos al corazón,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 99,
      "start": 273.19,
      "end": 274.99,
      "text": " dos al cerebro,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 100,
      "start": 274.99,
      "end": 276.89,
      "text": " tengo hipotiroidismo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 101,
      "start": 276.89,
      "end": 279.49,
      "text": " Ay, no sé qué me falta tener.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 102,
      "start": 279.49,
      "end": 282.05,
      "text": " Prostitis.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 103,
      "start": 282.05,
      "end": 283.45,
      "text": " Pero ya todo tengo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 104,
      "start": 283.45,
      "end": 286.15,
      "text": " Ya incluso la doctora del seguro me dijo,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 105,
      "start": 286.15,
      "end": 288.85,
      "text": " haga lo que quiera, coma lo que quiera,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 106,
      "start": 288.85,
      "end": 291.55,
      "text": " porque ya no hay nada que hacer por usted.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 107,
      "start": 291.55,
      "end": 293.45,
      "text": " ¿Se imagina?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 108,
      "start": 293.45,
      "end": 294.05,
      "text": " Sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 109,
      "start": 294.05,
      "end": 296.95,
      "text": " Eso me dijo la doctora del seguro.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 110,
      "start": 296.95,
      "end": 299.25,
      "text": " Ella decía, ah, no sea la pegada.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 111,
      "start": 299.25,
      "end": 301.45,
      "text": " Pues si tú no eres Dios para ver si es.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 112,
      "start": 301.45,
      "end": 303.15,
      "text": " ¿Tú ya te vas a morir, tú no?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 113,
      "start": 303.15,
      "end": 305.32,
      "text": " ¿Tú sí, tú no?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 114,
      "start": 305.32,
      "end": 305.92,
      "text": " ¿No crees?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 115,
      "start": 305.92,
      "end": 306.62,
      "text": " Sí, pues sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 116,
      "start": 306.62,
      "end": 307.52,
      "text": " Sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 117,
      "start": 307.52,
      "end": 309.92,
      "text": " Entonces, ¿tampoco no?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 118,
      "start": 309.92,
      "end": 311.92,
      "text": " No se pudo hacer el cambio.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 119,
      "start": 311.92,
      "end": 317.71,
      "text": " Me quedé con ganas de probar a ver cómo era easy.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 120,
      "start": 317.71,
      "end": 324.26,
      "text": " Pero no sé si ahora se pueda hacer el cambio",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 121,
      "start": 324.26,
      "end": 328.11,
      "text": " con los 134 metros.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 122,
      "start": 328.11,
      "end": 330.21,
      "text": " No, sí, en ese caso sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 123,
      "start": 330.21,
      "end": 331.41,
      "text": " Y no, no, no.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 124,
      "start": 331.41,
      "end": 332.31,
      "text": " Prácticamente no.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 125,
      "start": 332.31,
      "end": 333.21,
      "text": " No se podría.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 126,
      "start": 333.21,
      "end": 335.77,
      "text": " Con ese metraje no.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 127,
      "start": 335.77,
      "end": 338.47,
      "text": " ¿Cuál es el máximo?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 128,
      "start": 338.47,
      "end": 341.67,
      "text": " Máximo son 80, de 80 a 90.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 129,
      "start": 341.67,
      "end": 343.4,
      "text": " Ah, sí, con razón.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 130,
      "start": 343.4,
      "end": 347.0,
      "text": " No, pues fue lo bueno que el muchacho que vino me fue",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 131,
      "start": 347.0,
      "end": 348.5,
      "text": " sincero conmigo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 132,
      "start": 348.5,
      "end": 352.52,
      "text": " Y me dijo, esos son tantos metros y eso no se puede.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 133,
      "start": 352.52,
      "end": 355.76,
      "text": " Ah, bueno, pues entonces ni modo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 134,
      "start": 355.76,
      "end": 357.64,
      "text": " Ni modo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 135,
      "start": 357.64,
      "end": 359.94,
      "text": " Ya nada más cuando perdí la televisión,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 136,
      "start": 359.94,
      "end": 364.66,
      "text": " me pongo a ver El Chavo, El Chavo del 8.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 137,
      "start": 364.66,
      "end": 367.26,
      "text": " Y ya, es lo único que busco.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 138,
      "start": 367.26,
      "end": 370.36,
      "text": " Hay alguna película que me guste o algún programa que",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 139,
      "start": 370.36,
      "end": 372.26,
      "text": " me guste, lo veo así, ¿no?",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 140,
      "start": 372.26,
      "end": 376.27,
      "text": " La apago y pongo mi radio.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 141,
      "start": 377.27,
      "end": 381.0,
      "text": " Así es que pues ni modo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 142,
      "start": 381.0,
      "end": 384.12,
      "text": " Mi intención era buena, pero pues no.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 143,
      "start": 384.12,
      "end": 388.2,
      "text": " La de mi hijo también, porque mi hijo es el que me mantiene.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 144,
      "start": 388.2,
      "end": 392.3,
      "text": " Entonces, en parte mi esposo, no mucho, pero bueno.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 145,
      "start": 392.3,
      "end": 394.18,
      "text": " Pero bueno.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 146,
      "start": 394.18,
      "end": 399.48,
      "text": " Y me la paso aquí todo el tiempo sola, encerrada.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 147,
      "start": 399.48,
      "end": 403.55,
      "text": " Porque no me gusta tener la puerta abierta.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 148,
      "start": 403.55,
      "end": 404.15,
      "text": " Sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 149,
      "start": 404.15,
      "end": 406.71,
      "text": " Entonces, ni modo.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 150,
      "start": 407.71,
      "end": 411.21,
      "text": " Cuando tengan más metrajes para poder poner,",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 151,
      "start": 411.21,
      "end": 415.21,
      "text": " pues entonces ya me habla y a la mejor, a la mejor sí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 152,
      "start": 415.21,
      "end": 422.02,
      "text": " Y si aún Dios me permite estar aquí.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 153,
      "start": 422.02,
      "end": 422.52,
      "text": " OK.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 154,
      "start": 422.52,
      "end": 426.02,
      "text": " Bueno, en cualquiera igual, pues aquí registraron",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 155,
      "start": 426.02,
      "end": 428.02,
      "text": " prácticamente el número por si se llega a habilitar.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 156,
      "start": 428.02,
      "end": 428.82,
      "text": " OK.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 157,
      "start": 428.82,
      "end": 429.52,
      "text": " OK.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 158,
      "start": 429.52,
      "end": 430.22,
      "text": " Muy bien.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 159,
      "start": 430.22,
      "end": 431.12,
      "text": " Agradezco el tiempo alemán.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 160,
      "start": 431.12,
      "end": 432.02,
      "text": " Hasta el desmarque de Suizy.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 161,
      "start": 432.02,
      "end": 432.52,
      "text": " Que paso un día.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 162,
      "start": 432.52,
      "end": 433.02,
      "text": " Gracias.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 163,
      "start": 433.02,
      "end": 433.32,
      "text": " Hasta luego.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 164,
      "start": 433.32,
      "end": 434.32,
      "text": " Igualmente.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 165,
      "start": 434.32,
      "end": 435.32,
      "text": " Bye.",
      "speaker": null,
      "role": null,
      "words": []
    },
    {
      "id": 166,
      "start": 435.32,
      "end": 436.32,
      "text": " Hasta luego.",
      "speaker": null,
      "role": null,
      "words": []
    }
