      "role": null,
      "words": []
    },
    {
      "id": 95,
      "start": 280.88,
      "end": 282.88,
      "text": " Como que se corta, señorita.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 96,
      "start": 282.88,
      "end": 285.42,
      "text": " No, no alcanzo a escuchar, disculpe.",
