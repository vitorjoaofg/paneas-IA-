      "role": null,
      "words": []
    },
    {
      "id": 97,
      "start": 285.42,
      "end": 287.42,
      "text": " Por qué no alcanza a escuchar?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 98,
      "start": 287.42,
      "end": 291.73,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 99,
      "start": 291.73,
      "end": 295.04,
      "text": " Sí, como que se corta, señorita.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 100,
      "start": 295.04,
      "end": 297.58,
      "text": " No alcanzo a escuchar, disculpe.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 101,
      "start": 297.58,
      "end": 299.58,
      "text": " Es como Alcalde con Tabasco.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 102,
      "start": 299.58,
      "end": 301.58,
      "text": " Alcalde, Coletilla, Colonia.",
