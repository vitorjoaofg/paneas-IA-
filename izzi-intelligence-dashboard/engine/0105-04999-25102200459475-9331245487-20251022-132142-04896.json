      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 87,
      "start": 253.54,
      "end": 263.14,
      "text": " Real de Coletilla.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 88,
      "start": 263.14,
      "end": 267.31,
      "text": " OK.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 89,
      "start": 267.31,
      "end": 270.05,
      "text": " Muy bien.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 90,
      "start": 270.05,
      "end": 272.05,
      "text": " ¿En qué estados...?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 91,
      "start": 272.05,
      "end": 274.43,
      "text": " Bueno, perdón, ¿en qué municipio, señorita?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 92,
      "start": 274.43,
      "end": 276.88,
      "text": " En Antalca.",
