      "start": 273.99,
      "end": 275.99,
      "text": " Aquí aparece que se lo hicieron un ajuste.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 86,
      "start": 275.99,
      "end": 281.12,
      "text": " No, solamente está pagando el servicio más el IC móvil.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 87,
      "start": 281.56,
      "end": 282.56,
      "text": " Ajá.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 88,
      "start": 282.56,
      "end": 286.82,
      "text": " Entonces, ¿qué puedo hacer para mejorar mi...",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 89,
      "start": 286.82,
      "end": 288.82,
      "text": " ¿Quiere tener el servicio?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 90,
      "start": 288.82,
      "end": 291.2,
      "text": " Más o menos el servicio.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 91,
      "start": 291.2,
      "end": 293.36,
      "text": " ¿Quiere aumentarlos?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 92,
      "start": 293.36,
      "end": 295.46,
      "text": " ¿Cuál?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 93,
      "start": 295.46,
      "end": 297.46,
      "text": " Si le podemos...",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 94,
      "start": 297.46,
      "end": 299.46,
      "text": " ¿Puede tener el de la televisión?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 95,
      "start": 299.46,
      "end": 301.46,
      "text": " Sí, pero va a aumentar el costo, ¿no?",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 96,
      "start": 301.46,
      "end": 303.94,
      "text": " Exacto.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 97,
      "start": 303.94,
      "end": 305.94,
      "text": " Ajá, no.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 98,
      "start": 305.94,
      "end": 307.94,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 99,
      "start": 307.94,
      "end": 309.94,
      "text": " No me conviento.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 100,
      "start": 309.94,
      "end": 312.1,
      "text": " ¿No requiere?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 101,
      "start": 312.54,
      "end": 314.54,
      "text": " Tiene que...",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 102,
      "start": 314.54,
      "end": 316.54,
      "text": " Tiene que, de alguna u otra manera,",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 103,
      "start": 316.54,
      "end": 318.54,
      "text": " tiene que esperar más de 4 o 5 meses.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 104,
      "start": 318.54,
      "end": 320.54,
      "text": " Ah, bueno, no importa.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 105,
      "start": 320.54,
      "end": 322.54,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 106,
      "start": 322.54,
      "end": 326.54,
      "text": " Ok, pero es una promoción que se les da como ahorita.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 107,
      "start": 326.54,
      "end": 330.54,
      "text": " Tiene el IC móvil, lo está pagando usted a 165 pesos.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 108,
      "start": 330.54,
      "end": 332.54,
      "text": " Es solamente de 5 gigas.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 109,
      "start": 332.54,
      "end": 337.54,
      "text": " Ahorita lo tenemos el de 10 por 94 pesos.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 110,
      "start": 337.54,
      "end": 339.54,
      "text": " Ah, mira.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 111,
      "start": 339.54,
      "end": 341.54,
      "text": " Entonces, esa es una promoción que se les da a ustedes.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 112,
      "start": 342.07,
      "end": 344.07,
      "text": " Ahí lo puedo cambiar.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 113,
      "start": 344.07,
      "end": 346.07,
      "text": " Exacto.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 114,
      "start": 346.07,
      "end": 348.07,
      "text": " Ok, bueno, gracias.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 115,
      "start": 348.07,
      "end": 350.07,
      "text": " Ok, que tenga un excelente día.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 116,
      "start": 350.07,
