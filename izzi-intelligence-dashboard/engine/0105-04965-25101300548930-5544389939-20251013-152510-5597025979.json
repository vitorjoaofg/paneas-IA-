      "text": " Ya lo tengo.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 188,
      "start": 617.18,
      "end": 640.32,
      "text": " Un momento, por favor.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 189,
      "start": 640.32,
      "end": 676.72,
      "text": " Un momentito más, por favor.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 190,
      "start": 676.72,
      "end": 678.72,
      "text": " Sí, me parece que aún en su zona no hay cobertura.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 191,
      "start": 678.72,
      "end": 679.82,
      "text": " Se va a esperar.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 192,
      "start": 679.82,
      "end": 681.82,
      "text": " A ver si habilitan lo que es la cobertura, ¿de acuerdo?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 193,
      "start": 681.82,
      "end": 682.82,
      "text": " Ajá.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 194,
      "start": 682.82,
      "end": 685.27,
      "text": " Claro, una disculpa.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 195,
      "start": 685.27,
      "end": 687.27,
      "text": " Y además de eso, pues ahorita la pongo como nota",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 196,
      "start": 687.27,
      "end": 689.27,
      "text": " para que no le marquen, ¿de acuerdo?",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
      "id": 197,
      "start": 689.27,
      "end": 690.59,
      "text": " Sí.",
      "speaker": "Cliente",
      "role": null,
      "words": []
    },
    {
      "id": 198,
      "start": 690.59,
      "end": 691.59,
      "text": " Claro, un bonito día.",
      "speaker": "Atendente",
      "role": null,
      "words": []
    },
    {
