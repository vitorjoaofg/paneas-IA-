      "compression_ratio": 1.5112781524658203,
      "no_speech_prob": 0.19548064470291138,
      "speaker": "customer",
      "role": "customer"
    },
    {
      "id": 64,
      "start": 316.0,
      "end": 317.0,
      "text": " Goza en verte, rata.",
      "temperature": 0.0,
      "avg_logprob": -0.5058249831199646,
      "compression_ratio": 1.5112781524658203,
      "no_speech_prob": 0.19548064470291138,
      "speaker": "customer",
      "role": "customer"
    },
    {
      "id": 65,
      "start": 318.0,
      "end": 319.0,
      "text": " He querido hacer esto desde el día en que abriste tu maldita boca.",
