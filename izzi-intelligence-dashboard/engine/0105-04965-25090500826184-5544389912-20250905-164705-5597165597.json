      "avg_logprob": -0.5058249831199646,
      "compression_ratio": 1.5112781524658203,
      "no_speech_prob": 0.19548064470291138,
      "speaker": "customer",
      "role": "customer"
    },
    {
      "id": 66,
      "start": 324.0,
      "end": 325.0,
      "text": " Cuando escuchamos los gritos, no sé a quién.",
      "temperature": 0.0,
      "avg_logprob": -0.5058249831199646,
      "compression_ratio": 1.5112781524658203,
      "no_speech_prob": 0.19548064470291138,
      "speaker": "customer",
      "role": "customer"
    },
    {
      "id": 67,
      "start": 326.0,
      "end": 327.0,
      "text": " ¿A quién fue que tengo miedo?",
